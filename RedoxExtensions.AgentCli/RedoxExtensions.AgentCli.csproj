<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>rectl</AssemblyName>
    <RootNamespace>RedoxExtensions.AgentCli</RootNamespace>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);REDOX_AGENTCLI</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RedoxExtensions.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The schedule file model and due rules, shared with the plugin. -->
    <Compile Include="..\RedoxExtensions\Scheduling\ScheduledCommand.cs" Link="Shared\ScheduledCommand.cs" />
    <!-- The meta chain watch config model and merge rules, shared with the plugin. -->
    <Compile Include="..\RedoxExtensions\MetaChainWatch\MetaChainWatchConfig.cs" Link="Shared\MetaChainWatchConfig.cs" />
  </ItemGroup>

</Project>
